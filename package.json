{
  "name": "trip-itinerary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "eslint . && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && npx wrangler d1 migrations apply trip-itinerary --remote && npx wrangler deploy"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-query": "^5.107.1",
    "@types/qrcode": "^1.5.6",
    "hono": "^4.13.17",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "satori": "^0.63.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "serialize-javascript": ">=7.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~7.0.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.159.0"
  }
}
